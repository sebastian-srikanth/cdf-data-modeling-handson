# Copy this to the REPO ROOT as .env — never commit it.
#
#   cp .env.example .env
#
# Every <angle-bracket> value below must be replaced with a value from YOUR
# CDF project and YOUR identity provider. See PREREQUISITES.md for how to get
# each one, and docs/02-auth-and-security.md for why there are two identities.

# ---- CDF project ------------------------------------------------------------
CDF_CLUSTER=<your-cluster>                      # e.g. westeurope-1, api, az-eastus-1
CDF_PROJECT=<your-cdf-project>
CDF_URL=https://<your-cluster>.cognitedata.com

# ---- Identity provider ------------------------------------------------------
PROVIDER=entra_id                               # or: auth0, cognite_auth, other
LOGIN_FLOW=interactive                          # you, in a browser

# Interactive PUBLIC client — used by cdf build / deploy / clean / purge.
# Must have a redirect URI of http://localhost:53000 registered.
IDP_CLIENT_ID=<your-interactive-client-id>
IDP_TENANT_ID=<your-tenant-id>
IDP_SCOPES=https://<your-cluster>.cognitedata.com/.default
IDP_AUTHORITY_URL=https://login.microsoftonline.com/<your-tenant-id>
# Derived by the Toolkit:
#   IDP_TOKEN_URL=${IDP_AUTHORITY_URL}/oauth2/v2.0/token

# Confidential SERVICE PRINCIPAL — used ONLY inside a Transformation's
# `authentication:` block, so transformations can run unattended.
# This is the one and only secret in the whole course.
TRAINING_CDF_CLIENT_ID=<your-sp-client-id>
TRAINING_CDF_CLIENT_SECRET=<your-sp-client-secret>
